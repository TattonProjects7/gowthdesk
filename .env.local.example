# Shortlist runs with ZERO config (simulated market, local-only data, all Pro
# features unlocked). Add these to turn it into the real product. See SETUP.md.

# --- Market data (optional) ------------------------------------------------
FINNHUB_API_KEY=          # real-time quotes + screener fundamentals (finnhub.io)
ALPHAVANTAGE_API_KEY=     # daily candle history (alphavantage.co)

# --- AI coach + "Why it's moving" digests (optional) ----------------------
# Claude powers the in-app coach and the daily digests. Without a key the app
# uses a built-in offline coach, so everything still works.
ANTHROPIC_API_KEY=        # console.anthropic.com
AI_MODEL=                 # optional override; defaults to claude-opus-5-5

# --- Real mode: Trading 212 (optional) --------------------------------------
# Lets users connect their own Trading 212 account and place real orders.
# A long random string that encrypts each user's API key in their cookie.
# Generate one with:  openssl rand -base64 48
BROKER_SECRET=

# --- AI short thesis (optional) --------------------------------------------
OPENAI_API_KEY=           # AI bear/bull thesis; falls back to a rules engine

# --- Accounts + database: Supabase (optional) ------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-only; used by the Stripe webhook

# --- Payments: Stripe (optional) -------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID=  # the Pro recurring price id (price_...)

# --- App ------------------------------------------------------------------
# Also used as the URL the native iOS/Android shell loads (must be https for mobile).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Mobile in-app purchases: RevenueCat (optional) ------------------------
# Required for paid Pro on iOS/Android (App/Play store rules). See MOBILE.md.
NEXT_PUBLIC_REVENUECAT_IOS_KEY=
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=
